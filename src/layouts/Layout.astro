---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Cuzco Imperial & Machu Picchu — 5 días y 4 noches en la capital arqueológica de América, desde $899 USD.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F172A" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
