---
const highlights = [
  {
    title: 'Plaza de Armas & Calles Incas',
    text: 'Caminar entre muros megalíticos que resisten siglos y casonas coloniales con balcones repletos de flores.',
  },
  {
    title: 'El Valle Sagrado',
    text: 'Mercados artesanales de Pisac, fortalezas en Ollantaytambo y la mística ancestral del río Urubamba.',
  },
  {
    title: 'Machu Picchu al Amanecer',
    text: 'Tren panorámico Vistadome y acceso prioritario a la ciudadela sagrada con historiador privado.',
  },
  {
    title: 'Gastronomía Andina & Aromas',
    text: 'Cenas maridaje con alta cocina peruana, chicha morada artesanal y experiencias culinarias inolvidables.',
  },
];
---

<section class="section highlights" id="viaje">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow"><span class="tag-dot"></span>&nbsp; Cusco te espera</p>
      <h2>Cada Rincón de Esta Ciudad Tiene una Historia</h2>
    </div>

    <!-- Photo Collage Gallery -->
    <div class="photo-gallery">
      <div class="gallery-left">
        <img 
          src="https://images.unsplash.com/photo-1589556264800-03c0ca61864b?q=80&w=1000&auto=format&fit=crop" 
          alt="Calles coloniales e imperiales iluminadas en Cusco al atardecer" 
          class="gallery-img main-img"
        />
        <div class="gallery-caption">Cusco Imperial · Noche colonial</div>
      </div>

      <div class="gallery-right-grid">
        <div class="gallery-card">
          <img 
            src="https://images.unsplash.com/photo-1526392060635-9d6019884377?q=80&w=800&auto=format&fit=crop" 
            alt="Machu Picchu" 
            class="gallery-img"
          />
          <div class="gallery-card-label">Machu Picchu</div>
        </div>
        <div class="gallery-card">
          <img 
            src="https://images.unsplash.com/photo-1588887961168-96f30a992687?q=80&w=800&auto=format&fit=crop" 
            alt="Montaña de Colores Vinicunca" 
            class="gallery-img"
          />
          <div class="gallery-card-label">Montaña de Colores</div>
        </div>
        <div class="gallery-card">
          <img 
            src="https://images.unsplash.com/photo-1580618672591-eb180b1a973f?q=80&w=800&auto=format&fit=crop" 
            alt="Ollantaytambo Valle Sagrado" 
            class="gallery-img"
          />
          <div class="gallery-card-label">Valle Sagrado</div>
        </div>
        <div class="gallery-card">
          <img 
            src="https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=800&auto=format&fit=crop" 
            alt="Gastronomía Peruana" 
            class="gallery-img"
          />
          <div class="gallery-card-label">Alta Cocina Andina</div>
        </div>
      </div>
    </div>

    <!-- Feature Cards -->
    <div class="features-grid">
      {highlights.map((item, idx) => (
        <article class="feature-card">
          <div class="feature-num">0{idx + 1}</div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-head {
    max-width: 700px;
    margin-bottom: 48px;
  }
  .section-head h2 {
    margin-top: 14px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.12;
  }

  .photo-gallery {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 56px;
  }

  .gallery-left {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    background: var(--ink-surface);
  }
  .gallery-left .main-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
  }

  .gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px 24px 20px;
    background: linear-gradient(0deg, rgba(2,44,34,0.92) 0%, transparent 100%);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .gallery-right-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .gallery-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0,0,0,0.4);
    height: 190px;
    background: var(--ink-surface);
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .gallery-card:hover .gallery-img, .gallery-left:hover .main-img {
    transform: scale(1.05);
  }

  .gallery-card-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 14px 10px;
    background: linear-gradient(0deg, rgba(2,44,34,0.9) 0%, transparent 100%);
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-display);
  }

  .features-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }

  .feature-card {
    background: var(--ink-surface);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius-md);
    padding: 32px 28px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 4px; height: 100%;
    background: linear-gradient(180deg, var(--mustard), var(--emerald-light));
  }
  .feature-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.8rem;
    color: var(--mustard);
    opacity: 0.9;
    margin-bottom: 12px;
  }
  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 10px;
  }
  .feature-card p {
    color: var(--ink-soft);
    font-size: 0.96rem;
  }

  @media (min-width: 900px) {
    .photo-gallery {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
    }
    .gallery-left .main-img {
      height: 420px;
    }
    .gallery-card {
      height: 195px;
    }
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
